LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=nexvora-assistant
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# OpenAI voice (TTS). When OPENAI_API_KEY is set, OpenAI is used for speech by default;
# otherwise the agent falls back to Cartesia through LiveKit Inference.
OPENAI_API_KEY=
# TTS_PROVIDER=openai   # or "cartesia" to force the previous voice
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral

# Where the assistant reads Nexvora's company and service content from.
# WORDPRESS_GRAPHQL_URL=https://cms.nexvoraagency.com/graphql
